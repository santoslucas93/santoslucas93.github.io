+function lnbNormEscopo(v){
+  return String(v==null?'':v).normalize('NFD').replace(/[\u0300-\u036f]/g,'').trim().toUpperCase();
+}
+function lnbAreaEscopo(a){
+  a=lnbNormEscopo(a);
+  if(a==='OREC')return 'REC';
+  if(a==='SUPERINTENDENCIA'||a==='SUP')return 'LNB';
+  if(a==='COMUNICACAO')return 'COM';
+  if(a==='MARKETING')return 'MKT';
+  if(a==='TECNICO OPERACIONAL')return 'TOP';
+  if(a==='ADMINISTRATIVO & FINANCEIRO'||a==='ADMINISTRATIVO E FINANCEIRO')return 'A&F';
+  if(a==='EQUIPES')return 'EQP';
+  if(a==='RECEITAS')return 'REC';
+  return a;
+}
+function lnbEscopoPermiteRegistro(area,grupo,linha){
+  if(lnbAcessoTotal()||lnbAcessoLegadoSemCracha())return true;
+  const a=lnbAreaEscopo(area);
+  if(!a||a==='TRF')return false;
+  const deps=lnbEscopos('departamento').map(lnbAreaEscopo);
+  if(deps.includes(a))return true;
+  const linhas=lnbEscopos('linha').map(lnbNormEscopo);
+  if(linha!=null&&linhas.includes(lnbNormEscopo(linha)))return true;
+  const grupos=lnbEscopos('grupo').map(lnbNormEscopo);
+  if(grupo!=null){
+    const g=lnbNormEscopo(grupo);
+    if(grupos.includes(g)||grupos.includes(lnbNormEscopo(a+'-'+String(grupo).replace(/\s+/g,'-'))))return true;
+  }
+  return false;
+}
+function lnbRecursoDaTela(v,area,sup){
+  if(v==='dept')return LNB_ORCAMENTO_DEPT_RECURSOS[lnbAreaEscopo(area)]||null;
+  if(v==='sup'){
+    const direto=LNB_ORCAMENTO_SUP_RECURSOS[sup];
+    if(direto)return direto;
+    const pai=typeof supportParent==='function'?supportParent(sup):'';
+    if(pai==='COMP')return LNB_ORCAMENTO_RECURSOS.comp;
+    return LNB_ORCAMENTO_DEPT_RECURSOS[pai]||null;
+  }
+  return LNB_ORCAMENTO_RECURSOS[v]||null;
+}
+function lnbTelaPermitida(v,area,sup){
+  const recurso=lnbRecursoDaTela(v,area,sup);
+  if(!recurso||!lnbTemAcao(recurso,'visualizar'))return false;
+  if(v==='dept')return lnbEscopoPermiteRegistro(area,null,null);
+  if(v==='rec')return lnbEscopoPermiteRegistro('REC',null,null);
+  if(v==='sup'){
+    const pai=typeof supportParent==='function'?supportParent(sup):'';
