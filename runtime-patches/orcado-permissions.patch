+function lnbEscopos(tipo){
+  if(lnbAcessoTotal()||lnbAcessoLegadoSemCracha())return ['*'];
+  const esc=LNB_ACCESS&&LNB_ACCESS.escopos;
+  const vals=esc&&esc[tipo];
+  return Array.isArray(vals)?vals.map(v=>String(v)):[];
